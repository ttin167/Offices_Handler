# ==============================================================================
# ANTIGRAVITY AGENT CONTEXT IGNORE SPECIFICATION (.antigravityignore)
# ==============================================================================
# This file specifies file and directory patterns that AI Agents (Antigravity &
# Gemini) must NOT read, index, or include into the context window.
#
# Primary Objectives:
# 1. Context Window Optimization: Eliminate multi-megabyte binary bloat and tokens.
# 2. Hallucination Prevention: Exclude deprecated engines and runtime cache artifacts.
# 3. Privacy & Security: Prevent indexing databases, secrets, and customer uploads.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS & WEB BUILD ARTIFACTS
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# 2. PYTHON BYTECODE & TEST CACHES
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 3. WEB STUDIO RUNTIME OUTPUTS & USER UPLOADS
# ------------------------------------------------------------------------------
.web_outputs/
.web_uploads/
preview_slides/

# ------------------------------------------------------------------------------
# 4. SCRATCH SCRIPTS & TEMPORARY LOCK FILES
# ------------------------------------------------------------------------------
scratch/
*.tmp
*.temp*
~$*
.~lock.*
*_temp_assets/
test_out_assets/
tools/archive/

# ------------------------------------------------------------------------------
# 5. HEAVY PRECOMPILED BINARIES & DELIVERABLES
# ------------------------------------------------------------------------------
*.jar
tools/plantuml.jar
tools/deliverables/
excel_assets/

# ------------------------------------------------------------------------------
# 6. COMPILED DOCUMENT BINARIES & ASSETS (Preserve Markdown Source Docs)
# ------------------------------------------------------------------------------
# Ignore all heavy binary document formats
*.docx
*.pptx
*.pdf
*.xlsx
*.xls
*.csv

# Ignore generated intermediate image/asset folders inside docs/
docs/*_assets/
docs/..*
docs/preview_test/

# Explicitly ensure source Markdown & YAML configurations are readable
!docs/*.md
!docs/*.yaml
!docs/*.style.yaml
!docs/*_slide_spec.json
!specs/*.json
!specs/*.yaml

# ------------------------------------------------------------------------------
# 7. DEPRECATED LEGACY ENGINES
# ------------------------------------------------------------------------------
legacy_engines/

# ------------------------------------------------------------------------------
# 8. DATABASES & LOCAL SQLITE STORAGE
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 9. VIRTUAL ENVIRONMENTS & SENSITIVE CREDENTIALS
# ------------------------------------------------------------------------------
.env
.env.local
.env.*
.venv/
env/
venv/
ENV/

# ------------------------------------------------------------------------------
# 10. OS & IDE METADATA
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------------------------------------------
# 11. LOCAL LABOR LAW & BA ENTERPRISE WORKSTATION & ACADEMY (CONFIDENTIAL IP, LOCAL-ONLY)
# ------------------------------------------------------------------------------
core/ba_hub/
cli/ba_commands.py
cli/ba_print_commands.py
server/routes/ba_*.py
src/modules/ba_*.js
src/modules/labor_law_vault.js
src/modules/app_store.js
src/templates/ba/
.agents/skills/ba-workspace/
specs/ba_*.json
tests/test_ba_*.py
tests/test_labor_law_*.py
tests/test_regulatory_*.py
tests/test_hr_governance.py
labor_law_vault/
*.labor_law_vault.zip
.labor_law_fts.db
.labor_law_fts.db*
.universal_rag_fts.db
.universal_rag_fts.db*
ba_academy_vault/
.ba_academy.db*
data/labor_law/


