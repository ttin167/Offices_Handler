# .dockerignore — Antigravity Document Handler & BA Enterprise Workstation (v4.6.0)
# Exclude dev files, large test caches, local venv, and binary artifacts from Docker build context

.git
.github
.agents
.vscode
.idea
.antigravityignore
.geminiignore
.env
.env.*
*.env

# Node & Frontend Build
node_modules
dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments
venv
.venv
env
__pycache__
*.py[cod]
*$py.class
*.so
.pytest_cache
.coverage
htmlcov

# Temporary & Output Directories
.web_uploads
.web_outputs
mail_merge_output
diagram_assets/*.png
diagram_assets/*.svg
!diagram_assets/.gitkeep
logs
tmp
temp
scratch
tools/deliverables/
tools/archive/

# Heavy Documentation Binaries & Precompiled Assets
docs/*.pdf
docs/*.docx
docs/*.pptx
docs/*_assets/
docs/..*
docs/preview_test/
excel_assets/

# Local Scratch & Working State
.agent_scratchpad.md
*.tmp
*.bak
~$*
.~lock.*

# Local Labor Law & BA Enterprise Workstation (Confidential IP, Local-Only, Excluded from Docker / Render Cloud)
core/ba_hub/
cli/ba_commands.py
cli/ba_print_commands.py
.agents/skills/ba-workspace/
tests/test_ba_*.py
tests/test_labor_law_*.py
tests/test_regulatory_*.py
labor_law_vault/
*.labor_law_vault.zip
.labor_law_fts.db
.labor_law_fts.db*
data/labor_law/

